# Supabase: Project Settings -> Database -> Connection string

# Pooled connection (port 6543, "Transaction" mode) - used at runtime by the app
DATABASE_URL=postgres://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# Direct connection (port 5432) - used once by `npm run migrate`
DIRECT_URL=postgres://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres

PORT=4000

# Comma-separated list of allowed frontend origins.
# For local dev with the plain HTML page, this is wherever you're serving web/ from -
# e.g. http://localhost:8000 or http://127.0.0.1:5500 (Live Server), or your
# GitHub Pages URL once deployed.
CORS_ORIGIN=http://localhost:8000

# console.anthropic.com -> API Keys -> Create Key
# NEVER put this in any file under web/ - it must only ever live here, server-side.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
